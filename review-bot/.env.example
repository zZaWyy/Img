# Copia este archivo a .env (o exporta las variables) — NUNCA lo subas a git con valores reales.

# --- Google Business Profile (OAuth) ---
GBP_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GBP_CLIENT_SECRET=xxxxxxxx
GBP_REFRESH_TOKEN=xxxxxxxx   # se obtiene con: python -m reviewbot auth

# --- Generador de texto (elige uno según config.yaml -> llm.provider) ---
GEMINI_API_KEY=xxxxxxxx      # gratis en https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=xxxxxxxx   # alternativa de pago por uso (céntimos)

# --- Seguridad ---
# true = el bot genera las respuestas pero NO las publica (solo las muestra).
# Déjalo en true hasta validar la calidad de las respuestas.
DRY_RUN=true
